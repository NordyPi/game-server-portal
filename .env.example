# Copy to .env on the server:  cp .env.example .env
# The systemd unit (deploy/systemd/game-portal.service) loads this file.

# Which game servers the portal manages (see portal.config.example.json).
PORTAL_CONFIG=/home/YOUR_USER/game-server-portal/portal.config.json

# Where the portal keeps its own data (activity log).
DATA_DIR=/home/YOUR_USER/game-server-portal/data

# Cloudflare Access (Zero Trust → Access → Applications → your app).
# Team domain, e.g. myteam.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# "Application Audience (AUD) Tag" from the application's Overview tab.
CF_ACCESS_AUD=

# "systemd" on the server. "mock" fakes start/stop (used automatically by `npm run dev`).
# SERVICE_MODE=systemd
